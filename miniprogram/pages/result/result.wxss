.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 40rpx 80rpx;
  background: linear-gradient(180deg, #fff0f6 0%, #fff5f8 30%, #ffffff 100%);
}

.hero { text-align: center; padding: 24rpx 0 40rpx; }
.hero-title { font-size: 40rpx; font-weight: 700; color: #221c23; }

.score-block { margin: 32rpx 0 12rpx; }
.score-label { font-size: 28rpx; color: #948b93; display: block; }
.score-value { font-size: 108rpx; font-weight: 800; color: #e63a77; line-height: 1.1; }
.score-note { font-size: 22rpx; color: #a89fa7; line-height: 1.6; }

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(230, 58, 119, 0.06);
}

.section-title { font-size: 32rpx; font-weight: 600; color: #221c23; margin-bottom: 24rpx; }
.care-sub { font-size: 24rpx; color: #a89fa7; margin-top: -12rpx; margin-bottom: 20rpx; }

.style-tags { display: flex; flex-wrap: wrap; }
.style-tag {
  font-size: 28rpx;
  color: #e63a77;
  background: #fff0f6;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
}

.care-item { border-top: 2rpx solid #f7eef2; padding: 24rpx 0; }
.care-item:first-of-type { border-top: none; }
.care-head { display: flex; align-items: center; margin-bottom: 12rpx; }
.care-rank {
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  border-radius: 50%; background: #ff4d8d; color: #fff; font-size: 24rpx; margin-right: 16rpx;
}
.care-title { font-size: 30rpx; font-weight: 600; color: #443b43; }
.care-text { font-size: 27rpx; color: #6a6169; line-height: 1.7; }

.advice { font-size: 28rpx; color: #5a5159; line-height: 1.7; }

.animal-card { text-align: center; }
/* 动物图：玫粉圆底容器，整块卡片已在结果页最顶部 */
.animal-img-wrap { width: 200rpx; height: 200rpx; margin: 8rpx auto 16rpx; background: #ffe4ee; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.animal-img { display: block; width: 150rpx; height: 185rpx; }
.animal-name { font-size: 44rpx; font-weight: 700; color: #e63a77; margin: 12rpx 0; }
.animal-line { font-size: 28rpx; color: #5a5159; line-height: 1.7; }
.animal-note { font-size: 22rpx; color: #a89fa7; margin-top: 20rpx; }

.hook {
  font-size: 30rpx; color: #443b43; line-height: 1.6;
  background: #fff7fa; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx;
}

.btn {
  width: 100%; height: 76rpx; border-radius: 16rpx;
  font-size: 30rpx; font-weight: 600; border: none; margin-top: 16rpx;
  display: flex; align-items: center; justify-content: center;
  padding: 0; line-height: 1.3;
}
.btn-primary { background: #ff4d8d; color: #ffffff; }
.btn-line { background: #ffffff; color: #e63a77; border: 2rpx solid #ffc8dc; }
button::after { border: none; }

.phone-input {
  width: 100%; height: 88rpx; border: 2rpx solid #f0e6eb; border-radius: 16rpx;
  padding: 0 24rpx; font-size: 30rpx; box-sizing: border-box; margin-bottom: 20rpx;
}

.reserve-agree { display: flex; align-items: center; margin-bottom: 8rpx; }
.checkbox {
  width: 32rpx; height: 32rpx; line-height: 32rpx; text-align: center;
  border: 2rpx solid #ffb0cd; border-radius: 8rpx; font-size: 22rpx; margin-right: 14rpx; flex-shrink: 0;
}
.checkbox.checked { background: #ff4d8d; color: #fff; border-color: #ff4d8d; }
.agree-text { font-size: 24rpx; color: #948b93; }
.reserve-done { font-size: 28rpx; color: #e63a77; text-align: center; padding: 24rpx 0; }

.again { margin-top: 32rpx; }
.legal-links { display: flex; justify-content: center; gap: 28rpx; padding-top: 24rpx; }
.legal-link { font-size: 24rpx; color: #e63a77; text-decoration: underline; }
.delete-entry {
  text-align: center; font-size: 24rpx; color: #a89fa7;
  padding: 24rpx 0 8rpx; text-decoration: underline;
}
.disclaimer { font-size: 22rpx; color: #a89fa7; line-height: 1.6; text-align: center; margin-top: 24rpx; white-space: pre-line; }
/* 隐藏但可导出：display:none 会使 2d canvas 无尺寸，改用绝对定位移出屏幕 */
.share-canvas-hidden { position: fixed; left: -9999rpx; top: -9999rpx; width: 640px; height: 1120px; }
/* 动物图：CC0 本地 SVG，失败不影响文字结果 */
/* 文化名片：五行身份卡，纯文化叙事，不参与计分与排序 */
.culture-card { margin-top: 24rpx; }
.culture-head { display: flex; align-items: center; gap: 20rpx; margin: 20rpx 0; }
.culture-badge { width: 88rpx; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 50%; background: #ff4d8d; color: #fff; font-size: 40rpx; font-weight: 600; flex-shrink: 0; }
.culture-line { font-size: 30rpx; color: #993556; font-weight: 500; line-height: 1.5; }
.culture-text { font-size: 27rpx; color: #443b43; line-height: 1.7; }
.culture-note { font-size: 24rpx; color: #b07a3a; line-height: 1.6; margin-top: 12rpx; }
.culture-lore { font-size: 25rpx; color: #8a6a3a; line-height: 1.6; background: #faf4e8; border-radius: 12rpx; padding: 16rpx 20rpx; margin-top: 16rpx; }
.culture-extended { font-size: 25rpx; color: #6b626a; line-height: 1.7; margin-top: 16rpx; }
