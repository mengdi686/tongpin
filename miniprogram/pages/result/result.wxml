<view class="page" wx:if="{{result}}">

  <!-- 隐藏画布：仅用于生成转发卡片图，不参与页面布局 -->
  <canvas type="2d" id="shareCard" class="share-canvas-hidden"></canvas>

  <view class="hero">
    <view class="hero-title">{{copy.result.title}}</view>
    <view class="hero-animal" wx:if="{{animalImgOk}}">
      <image class="hero-animal-img" src="/assets/animals/{{animal.file}}" mode="aspectFit" binderror="onAnimalImgError" />
    </view>
    <view class="hero-animal-name">{{animal.name}}</view>
    <view class="score-block">
      <text class="score-label">{{copy.result.scoreLabel}}</text>
      <text class="score-value">{{result.resonance}}{{copy.result.scoreUnit}}</text>
    </view>
    <view class="score-note">{{copy.result.scoreNote}}</view>
  </view>

  <view class="card">
    <view class="section-title">{{copy.result.styleTitle}}</view>
    <view class="style-tags">
      <text class="style-tag" wx:for="{{result.styles}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">{{copy.result.careTitle}}</view>
    <view class="care-sub">{{copy.result.careSub}}</view>
    <view class="care-item" wx:for="{{result.careItems}}" wx:key="dim">
      <view class="care-head">
        <text class="care-rank">{{index + 1}}</text>
        <text class="care-title">{{item.title}}</text>
      </view>
      <view class="care-text">{{item.text}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">{{copy.result.adviceTitle}}</view>
    <view class="advice">{{result.advice}}</view>
  </view>

  <view class="card animal-card">
    <view class="section-title">{{copy.result.animalTitle}}</view>
    <view class="animal-name">{{animal.name}}</view>
    <view class="animal-line">{{animal.line}}</view>
    <view class="animal-note">{{copy.result.animalNote}}</view>
  </view>

  <view class="card culture-card" wx:if="{{culture.available}}">
    <view class="section-title">你的文化名片</view>
    <view class="culture-head">
      <view class="culture-badge">{{culture.dayMaster}}</view>
      <view class="culture-line">{{culture.shareLine}}</view>
    </view>
    <view class="culture-text">{{culture.text}}</view>
    <view class="culture-note" wx:if="{{culture.note}}">{{culture.note}}</view>
    <view class="culture-lore">{{culture.lore}}</view>
    <view class="culture-extended">{{culture.extended}}</view>
  </view>

  <view class="card share-card">
    <view class="section-title">{{copy.result.shareTitle}}</view>
    <view class="hook">{{hook}}</view>
    <button class="btn btn-primary" bindtap="onCopy">{{copy.result.shareCopy}}</button>
    <button class="btn btn-line" open-type="share">转发给朋友</button>
  </view>

  <view class="card reserve-card">
    <view class="section-title">{{copy.result.reserve}}</view>
    <block wx:if="{{!reserved}}">
      <input
        class="phone-input"
        placeholder="{{copy.result.reservePlaceholder}}"
        type="number"
        maxlength="11"
        value="{{phone}}"
        bindinput="onPhone"
      />
      <view class="reserve-agree" bindtap="onToggleAgree">
        <text class="checkbox {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</text>
        <text class="agree-text">{{copy.result.reserveAgree}}</text>
      </view>
      <button class="btn btn-primary" bindtap="onReserve">提交预约</button>
    </block>
    <view class="reserve-done" wx:else>{{copy.result.reserveDone}}</view>
  </view>

  <button class="btn btn-line again" bindtap="onAgain">{{copy.result.again}}</button>
  <view class="legal-links">
    <text class="legal-link" bindtap="onLegal" data-type="privacy">《隐私政策》</text>
    <text class="legal-link" bindtap="onLegal" data-type="terms">《用户协议》</text>
  </view>
  <view class="delete-entry" bindtap="onDeleteData">{{copy.result.deleteData}}</view>

  <view class="disclaimer">{{copy.disclaimer}}</view>

</view>
