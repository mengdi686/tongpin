.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 80rpx 40rpx 64rpx;
  background: linear-gradient(180deg, #fff5f8 0%, #ffffff 45%);
}

.gate { width: 100%; }

.brand {
  font-size: 64rpx;
  font-weight: 700;
  color: #e63a77;
  letter-spacing: 6rpx;
  text-align: center;
  margin-top: 60rpx;
}

.slogan {
  font-size: 30rpx;
  color: #948b93;
  text-align: center;
  margin-top: 16rpx;
  margin-bottom: 80rpx;
}

.lead {
  font-size: 30rpx;
  color: #5a5159;
  line-height: 1.7;
  text-align: center;
  margin: 24rpx 0 56rpx;
  white-space: pre-line;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(230, 58, 119, 0.08);
}

.gate-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #221c23;
  text-align: center;
  margin-bottom: 44rpx;
}

.consent-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #221c23;
  margin-bottom: 28rpx;
}

.consent-item {
  font-size: 28rpx;
  color: #5a5159;
  line-height: 1.7;
  margin-bottom: 18rpx;
}

.btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-top: 24rpx;
  border: none;
}

.btn-primary {
  background: #ff4d8d;
  color: #ffffff;
}

.btn-line {
  background: #ffffff;
  color: #e63a77;
  border: 2rpx solid #ffc8dc;
}

button::after { border: none; }

.disclaimer {
  font-size: 22rpx;
  color: #a89fa7;
  line-height: 1.6;
  text-align: center;
  margin-top: 48rpx;
  white-space: pre-line;
}
