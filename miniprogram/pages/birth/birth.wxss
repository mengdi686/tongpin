.page { box-sizing: border-box; min-height: 100vh; padding: 48rpx 40rpx 64rpx; background: #fff5f8; }
.card { background: #fff; border-radius: 28rpx; padding: 48rpx 40rpx; box-shadow: 0 12rpx 40rpx rgba(230,58,119,.08); }
.title { font-size: 38rpx; font-weight: 600; color: #221c23; }
.desc { font-size: 26rpx; color: #948b93; line-height: 1.6; margin: 16rpx 0 36rpx; }
.field { margin-bottom: 32rpx; }
.label { font-size: 28rpx; color: #443b43; font-weight: 500; display: block; margin-bottom: 16rpx; }
.picker-value { height: 76rpx; line-height: 76rpx; padding: 0 24rpx; border: 2rpx solid #f0e6eb; border-radius: 16rpx; font-size: 30rpx; color: #443b43; background: #fffafd; }
.picker-value.placeholder { color: #b8afb6; }
.gender-row { display: flex; gap: 20rpx; }
.gender { flex: 1; height: 76rpx; line-height: 76rpx; text-align: center; border: 2rpx solid #f0e6eb; border-radius: 16rpx; font-size: 30rpx; color: #443b43; background: #fffafd; }
.gender.active { border-color: #ff4d8d; background: #fff0f6; color: #e63a77; font-weight: 600; }
.consent-check { display: flex; align-items: flex-start; gap: 16rpx; margin: 24rpx 0; }
.checkbox { width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center; border: 2rpx solid #ffb0cd; border-radius: 8rpx; flex-shrink: 0; font-size: 26rpx; color: #fff; }
.checkbox.checked { background: #ff4d8d; border-color: #ff4d8d; }
.consent-text { font-size: 26rpx; color: #6b626a; line-height: 1.6; }
.btn { width: 100%; height: 76rpx; line-height: 76rpx; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; text-align: center; border: none; margin-top: 16rpx; }
.btn-primary { background: #ff4d8d; color: #fff; }
button::after { border: none; }
.legal-links { display: flex; gap: 28rpx; justify-content: center; margin-top: 24rpx; }
.legal-link { font-size: 24rpx; color: #e63a77; text-decoration: underline; }
