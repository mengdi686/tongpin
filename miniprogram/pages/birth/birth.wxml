<view class="page">
  <view class="card">
    <view class="title">出生信息（用于文化彩蛋）</view>
    <view class="desc">补充出生日期可生成传统文化身份卡；时辰可以跳过，跳过时结果会标注"信息不足"。不用于匹配排序，不收费解锁。</view>

    <view class="field">
      <text class="label">出生日期（阳历）</text>
      <picker mode="date" start="1900-01-01" end="{{maxDate}}" value="{{date}}" bindchange="onDate">
        <view class="picker-value {{date ? '' : 'placeholder'}}">{{date || '请选择出生日期'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">出生时辰（可跳过）</text>
      <picker mode="selector" range="{{timeOptions}}" value="{{timeIndex}}" bindchange="onTime">
        <view class="picker-value">{{timeLabel}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">性别</text>
      <view class="gender-row">
        <view class="gender {{gender === 'f' ? 'active' : ''}}" data-g="f" bindtap="onGender">女</view>
        <view class="gender {{gender === 'm' ? 'active' : ''}}" data-g="m" bindtap="onGender">男</view>
      </view>
    </view>

    <view class="consent-check" bindtap="onConsent">
      <text class="checkbox {{consented ? 'checked' : ''}}">{{consented ? '✓' : ''}}</text>
      <text class="consent-text">我单独同意：加密保存我的出生日期与时辰，用于生成文化内容；不用于匹配排序，不收费解锁，我可随时要求删除。</text>
    </view>

    <button class="btn btn-primary" bindtap="onNext">下一步，开始测评</button>
    <view class="legal-links">
      <text class="legal-link" bindtap="onLegal" data-type="privacy">《隐私政策》</text>
      <text class="legal-link" bindtap="onLegal" data-type="terms">《用户协议》</text>
    </view>
  </view>
</view>
